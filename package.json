{
  "name": "wager-core",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --exec bun",
    "start:dev": "nest start --watch --exec bun",
    "start:debug": "nest start --watch --debug --exec bun",
    "start:prod": "bun dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test ./test/app.e2e.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1147.0",
    "@mikro-orm/core": "7.2.4",
    "@mikro-orm/decorators": "7.2.4",
    "@mikro-orm/migrations": "7.2.4",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "12.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.4",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@oxc-node/core": "^0.1.5",
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  },
  "mikro-orm": {
    "preferTs": true,
    "tsLoader": "oxc",
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  }
}
